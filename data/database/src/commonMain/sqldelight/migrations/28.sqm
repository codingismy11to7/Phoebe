CREATE TABLE SmartPlaylistRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    filterSpec TEXT NOT NULL,
    sortSpec TEXT NOT NULL,
    trackLimit INTEGER,
    createdAtMs INTEGER NOT NULL,
    updatedAtMs INTEGER NOT NULL,
    enabled INTEGER NOT NULL DEFAULT 1
);

CREATE TABLE SavedSearchRow (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    querySpec TEXT NOT NULL,
    createdAtMs INTEGER NOT NULL,
    updatedAtMs INTEGER NOT NULL
);

CREATE TABLE LocalMetadataOverrideRow (
    trackId TEXT NOT NULL PRIMARY KEY,
    updateSpec TEXT NOT NULL,
    providerType TEXT,
    syncStatus TEXT NOT NULL DEFAULT 'LocalOnly',
    updatedAtMs INTEGER NOT NULL
);
