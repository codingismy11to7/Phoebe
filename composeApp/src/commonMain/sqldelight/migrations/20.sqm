ALTER TABLE DownloadRow ADD COLUMN downloadUrl TEXT NOT NULL DEFAULT '';
ALTER TABLE DownloadRow ADD COLUMN targetPath TEXT NOT NULL DEFAULT '';
ALTER TABLE DownloadRow ADD COLUMN downloadedBytes INTEGER NOT NULL DEFAULT 0;
ALTER TABLE DownloadRow ADD COLUMN totalBytes INTEGER;
ALTER TABLE DownloadRow ADD COLUMN updatedAtMs INTEGER NOT NULL DEFAULT 0;
ALTER TABLE DownloadRow ADD COLUMN batchId TEXT;
ALTER TABLE DownloadRow ADD COLUMN error TEXT;
UPDATE DownloadRow
SET dlState = 'Queued',
    progress = 0,
    downloadedBytes = 0,
    totalBytes = NULL,
    error = NULL
WHERE dlState = 'Downloading';
